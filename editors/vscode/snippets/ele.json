{
  "Function (flow)": {
    "prefix": "flow",
    "body": [
      "flow ${1:name}(${2:params}) => ${3:Type} {",
      "\t${0:give 0}",
      "}"
    ],
    "description": "ELE v2 function declaration"
  },
  "Data shape (shape)": {
    "prefix": "shape",
    "body": [
      "shape ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "}"
    ],
    "description": "ELE v2 nominal data shape (struct)"
  },
  "Choice enum (choice)": {
    "prefix": "choice",
    "body": [
      "choice ${1:Name} {",
      "\t${2:Variant},",
      "}"
    ],
    "description": "ELE v2 algebraic choice enum"
  },
  "Type extension (extend)": {
    "prefix": "extend",
    "body": [
      "extend ${1:Type} {",
      "\t${0}",
      "}"
    ],
    "description": "ELE v2 type method extension (impl)"
  },
  "Contract implementation (extend Contract on Type)": {
    "prefix": "extend on",
    "body": [
      "extend ${1:Contract} on ${2:Type} {",
      "\t${0}",
      "}"
    ],
    "description": "ELE v2 contract implementation on a type"
  },
  "Contract interface (contract)": {
    "prefix": "contract",
    "body": [
