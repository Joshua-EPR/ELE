take x86_64
take pe64
take win64_rt
take native_rt_platform

// CF_UNICODETEXT, resolved from system32 without a foreign runtime.
fixed WC_LIMIT = 67108864

shape WcData {
    dll: Int
    open: Int
    close: Int
    empty: Int
    set: Int
    get: Int
    available: Int
}

flow wcAscii(code: edit X64Code, value: view Text) => Int {
    hold at = code.bytes.length
    each i among 0..value.byteLength { code.bytes@push(value@byteAt(i)) }
    code.bytes@push(0)
    give at
}
flow wcWide(code: edit X64Code, value: view Text) => Int {
    during code.bytes.length % 8 != 0 { code.bytes@push(0) }
    hold at = code.bytes.length
    each i among 0..value.byteLength { code.bytes@push(value@byteAt(i)); code.bytes@push(0) }
    code.bytes@push(0)
    code.bytes@push(0)
    give at
}
flow wcData(code: edit X64Code) => WcData {
    hold dll_name = "user32.dll"
    hold open_name = "OpenClipboard"
    hold close_name = "CloseClipboard"
    hold empty_name = "EmptyClipboard"
    hold set_name = "SetClipboardData"
    hold get_name = "GetClipboardData"
    hold available_name = "IsClipboardFormatAvailable"
    hold dll = wcWide(edit code, view dll_name)
    hold open = wcAscii(edit code, view open_name)
    hold close = wcAscii(edit code, view close_name)
    hold empty = wcAscii(edit code, view empty_name)
    hold set = wcAscii(edit code, view set_name)
    hold get = wcAscii(edit code, view get_name)
    hold available = wcAscii(edit code, view available_name)
    give WcData(dll: dll, open: open, close: close, empty: empty, set: set, get: get, available: available)
}
flow wcLea(code: edit X64Code, reg: Int, at: Int) {
    hold fix = x64LeaRipPlaceholder(edit code, reg)
    x64PatchRelative(edit code, fix, at)
}
flow wcPatch(code: edit X64Code, at: Int) { x64PatchRelative(edit code, at, code.bytes.length) }
flow wcPatchAll(code: edit X64Code, at: view List of[Int]) {
    each i among 0..at.length { wcPatch(edit code, at[i]) }
}
flow wcJump(code: edit X64Code, at: Int) {
    hold fix = x64JumpPlaceholder(edit code)
    x64PatchRelative(edit code, fix, at)
}
flow wcCall(code: edit X64Code, at: Int) {
    hold fix = x64CallPlaceholder(edit code)
    x64PatchRelative(edit code, fix, at)
}
flow wcBegin(code: edit X64Code) { x64FrameBegin(edit code, 16); w64AlignStack(edit code, 64) }
flow wcStack(code: edit X64Code, index: Int, reg: Int) { x64StoreMem64(edit code, 4, 32 + 8 * index, reg) }
flow wcIf(code: edit X64Code, reg: Int, value: Int, cond: Int) => Int {
    x64MovImm64(edit code, 10, value)
    x64CmpReg(edit code, reg, 10)
    x64SetCondition(edit code, cond)
    x64TestRax(edit code)
    give x64ConditionalPlaceholder(edit code, false)
}
flow wcFn(code: edit X64Code, slot: Int) {
    x64LoadSlot(edit code, 11, slot)
    x64CallReg(edit code, 11)
}
flow wcLoadDll(code: edit X64Code, imports: edit Pe64Imports, d: view WcData) => Int {
    wcLea(edit code, 1, d.dll)
    x64MovImm64(edit code, 2, 0)
    x64MovImm64(edit code, 8, 2048)
    w64CallImport(edit code, edit imports, pe64ImportLoadLibraryExW())
    x64StoreSlot(edit code, 2, 0)
    x64TestRax(edit code)
    give x64ConditionalPlaceholder(edit code, true)
}
flow wcResolve(code: edit X64Code, imports: edit Pe64Imports, name: Int, slot: Int) => Int {
    x64LoadSlot(edit code, 1, 2)
    wcLea(edit code, 2, name)
    w64CallImport(edit code, edit imports, pe64ImportGetProcAddress())
    x64StoreSlot(edit code, slot, 0)
    x64TestRax(edit code)
    give x64ConditionalPlaceholder(edit code, true)
}

// 0 list, 1 count, 2 DLL, 3 Open, 4 Close, 5 Empty, 6 Set,
// 7 HGLOBAL, 8 lock, 9 UTF-8 buffer, 10 capacity, 11 WCHAR count,
// 12 status, 13 opened, 14 index.
flow wcEmitWrite(code: edit X64Code, imports: edit Pe64Imports, rt: view PfRuntime, d: view WcData) => Int {
    hold entry = code.bytes.length
    wcBegin(edit code)
    x64StoreSlot(edit code, 0, 7)
    x64StoreSlot(edit code, 1, 6)
    each s among 2..15 { x64MovImm64(edit code, 0, 0); x64StoreSlot(edit code, s, 0) }
    x64MovImm64(edit code, 0, -5)
    x64StoreSlot(edit code, 12, 0)
    change invalid: List of[Int] = List[]
    x64LoadSlot(edit code, 1, 1)
    invalid@push(wcIf(edit code, 1, 0, 6))
    invalid@push(wcIf(edit code, 1, WC_LIMIT, 8))
    x64LoadSlot(edit code, 2, 0)
    x64LoadMem64(edit code, 2, 2, 8)
    x64CmpReg(edit code, 1, 2)
    x64SetCondition(edit code, 8)
    x64TestRax(edit code)
    invalid@push(x64ConditionalPlaceholder(edit code, false))
    x64LoadSlot(edit code, 7, 1)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 7, 10)
    wcCall(edit code, rt.text_new)
    x64StoreSlot(edit code, 9, 0)
    x64StoreSlot(edit code, 10, 2)
    hold pack = code.bytes.length
    x64LoadSlot(edit code, 1, 14)
    x64LoadSlot(edit code, 2, 1)
    x64CmpReg(edit code, 1, 2)
    x64SetCondition(edit code, 9)
    x64TestRax(edit code)
    hold packed = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 8, 0)
    x64LoadMem64(edit code, 8, 8, 0)
    x64MovReg(edit code, 9, 1)
    x64MovImm64(edit code, 10, 8)
    x64MulReg(edit code, 9, 10)
    x64AddReg(edit code, 8, 9)
    x64LoadMem64(edit code, 2, 8, 0)
    hold bad_zero = wcIf(edit code, 2, 1, 6)
    hold bad_byte = wcIf(edit code, 2, 255, 8)
    x64LoadSlot(edit code, 8, 9)
    x64AddReg(edit code, 8, 1)
    x64StoreMem8(edit code, 8, 0, 2)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 1, 10)
    x64StoreSlot(edit code, 14, 1)
    wcJump(edit code, pack)
    wcPatch(edit code, packed)
    x64LoadSlot(edit code, 8, 9)
    x64LoadSlot(edit code, 9, 1)
    x64AddReg(edit code, 8, 9)
    x64MovImm64(edit code, 0, 0)
    x64StoreMem8(edit code, 8, 0, 0)
    // Strict UTF-8 -> UTF-16, query then fill, terminator included.
    x64MovImm64(edit code, 1, 65001)
    x64MovImm64(edit code, 2, 8)
    x64LoadSlot(edit code, 8, 9)
    x64MovImm64(edit code, 9, -1)
    x64MovImm64(edit code, 0, 0)
    wcStack(edit code, 0, 0)
    wcStack(edit code, 1, 0)
    w64CallImport(edit code, edit imports, pe64ImportMultiByteToWideChar())
    x64StoreSlot(edit code, 11, 0)
    x64TestEax(edit code)
    hold convert_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 1, 2)
    x64MovReg(edit code, 2, 0)
    x64AddReg(edit code, 2, 0)
    w64CallImport(edit code, edit imports, pe64ImportGlobalAlloc())
    x64StoreSlot(edit code, 7, 0)
    x64TestRax(edit code)
    hold alloc_failed = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalLock())
    x64StoreSlot(edit code, 8, 0)
    x64TestRax(edit code)
    hold lock_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 1, 65001)
    x64MovImm64(edit code, 2, 8)
    x64LoadSlot(edit code, 8, 9)
    x64MovImm64(edit code, 9, -1)
    x64LoadSlot(edit code, 0, 8)
    wcStack(edit code, 0, 0)
    x64LoadSlot(edit code, 0, 11)
    wcStack(edit code, 1, 0)
    w64CallImport(edit code, edit imports, pe64ImportMultiByteToWideChar())
    x64LoadSlot(edit code, 1, 11)
    x64CmpReg(edit code, 0, 1)
    x64SetCondition(edit code, 5)
    x64TestRax(edit code)
    hold fill_failed = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalUnlock())
    x64MovImm64(edit code, 0, 0)
    x64StoreSlot(edit code, 8, 0)
    hold no_dll = wcLoadDll(edit code, edit imports, d)
    change resolve_failed: List of[Int] = List[]
    resolve_failed@push(wcResolve(edit code, edit imports, d.open, 3))
    resolve_failed@push(wcResolve(edit code, edit imports, d.close, 4))
    resolve_failed@push(wcResolve(edit code, edit imports, d.empty, 5))
    resolve_failed@push(wcResolve(edit code, edit imports, d.set, 6))
    x64MovImm64(edit code, 1, 0)
    wcFn(edit code, 3)
    x64TestEax(edit code)
    hold open_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 0, 1)
    x64StoreSlot(edit code, 13, 0)
    wcFn(edit code, 5)
    x64TestEax(edit code)
    hold empty_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 1, 13)
    x64LoadSlot(edit code, 2, 7)
    wcFn(edit code, 6)
    x64TestRax(edit code)
    hold set_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 0, 0)
    x64StoreSlot(edit code, 7, 0) // ownership transferred to Windows
    x64StoreSlot(edit code, 12, 0)
    hold cleanup = code.bytes.length
    wcPatch(edit code, no_dll)
    wcPatchAll(edit code, view resolve_failed)
    wcPatch(edit code, open_failed)
    wcPatch(edit code, empty_failed)
    wcPatch(edit code, set_failed)
    wcPatch(edit code, alloc_failed)
    wcPatch(edit code, lock_failed)
    wcPatch(edit code, fill_failed)
    x64LoadSlot(edit code, 0, 8)
    x64TestRax(edit code)
    hold no_unlock = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalUnlock())
    wcPatch(edit code, no_unlock)
    x64LoadSlot(edit code, 0, 13)
    x64TestRax(edit code)
    hold no_close = x64ConditionalPlaceholder(edit code, true)
    wcFn(edit code, 4)
    x64TestEax(edit code)
    hold closed = x64ConditionalPlaceholder(edit code, false)
    x64MovImm64(edit code, 0, -5)
    x64StoreSlot(edit code, 12, 0)
    wcPatch(edit code, closed)
    wcPatch(edit code, no_close)
    x64LoadSlot(edit code, 0, 7)
    x64TestRax(edit code)
    hold no_free = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalFree())
    wcPatch(edit code, no_free)
    x64LoadSlot(edit code, 0, 2)
    x64TestRax(edit code)
    hold no_release = x64ConditionalPlaceholder(edit code, true)
    x64MovReg(edit code, 1, 0)
    w64CallImport(edit code, edit imports, pe64ImportFreeLibrary())
    wcPatch(edit code, no_release)
    x64LoadSlot(edit code, 0, 9)
    x64TestRax(edit code)
    hold no_drop = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 7, 9)
    x64LoadSlot(edit code, 6, 10)
    wcCall(edit code, rt.text_drop)
    wcPatch(edit code, no_drop)
    x64LoadSlot(edit code, 0, 12)
    x64FrameEnd(edit code)
    wcPatch(edit code, bad_zero)
    wcPatch(edit code, bad_byte)
    wcPatch(edit code, convert_failed)
    x64MovImm64(edit code, 0, -1)
    x64StoreSlot(edit code, 12, 0)
    wcJump(edit code, cleanup)
    wcPatchAll(edit code, view invalid)
    x64MovImm64(edit code, 0, -1)
    x64FrameEnd(edit code)
    give entry
}

// 0 list, 1 limit, 2 DLL, 3 Open, 4 Close, 5 Get, 6 Available,
// 7 global, 8 lock, 9 UTF-8 temporary, 10 capacity, 11 byte count,
// 12 status, 13 opened, 14 GlobalSize, 15 scan offset.
flow wcEmitRead(code: edit X64Code, imports: edit Pe64Imports, rt: view PfRuntime, d: view WcData, list_reserve: Int) => Int {
    hold entry = code.bytes.length
    wcBegin(edit code)
    x64StoreSlot(edit code, 0, 7)
    x64StoreSlot(edit code, 1, 6)
    each s among 2..16 { x64MovImm64(edit code, 0, 0); x64StoreSlot(edit code, s, 0) }
    x64MovImm64(edit code, 0, -5)
    x64StoreSlot(edit code, 12, 0)
    change invalid: List of[Int] = List[]
    x64LoadSlot(edit code, 1, 1)
    invalid@push(wcIf(edit code, 1, 0, 6))
    invalid@push(wcIf(edit code, 1, WC_LIMIT, 8))
    x64LoadSlot(edit code, 2, 0)
    x64LoadMem64(edit code, 2, 2, 8)
    invalid@push(wcIf(edit code, 2, 0, 5))
    hold no_dll = wcLoadDll(edit code, edit imports, d)
    change resolve_failed: List of[Int] = List[]
    resolve_failed@push(wcResolve(edit code, edit imports, d.open, 3))
    resolve_failed@push(wcResolve(edit code, edit imports, d.close, 4))
    resolve_failed@push(wcResolve(edit code, edit imports, d.get, 5))
    resolve_failed@push(wcResolve(edit code, edit imports, d.available, 6))
    x64MovImm64(edit code, 1, 0)
    wcFn(edit code, 3)
    x64TestEax(edit code)
    hold open_failed = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 0, 1)
    x64StoreSlot(edit code, 13, 0)
    x64MovImm64(edit code, 1, 13)
    wcFn(edit code, 6)
    x64TestEax(edit code)
    hold no_text = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 1, 13)
    wcFn(edit code, 5)
    x64StoreSlot(edit code, 7, 0)
    x64TestRax(edit code)
    hold no_data = x64ConditionalPlaceholder(edit code, true)
    x64MovReg(edit code, 1, 0)
    w64CallImport(edit code, edit imports, pe64ImportGlobalSize())
    x64StoreSlot(edit code, 14, 0)
    x64TestRax(edit code)
    hold no_size = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalLock())
    x64StoreSlot(edit code, 8, 0)
    x64TestRax(edit code)
    hold no_lock = x64ConditionalPlaceholder(edit code, true)
    // Bound the NUL scan by GlobalSize; never read beyond a foreign HGLOBAL.
    hold scan = code.bytes.length
    x64LoadSlot(edit code, 1, 15)
    x64MovImm64(edit code, 10, 2)
    x64AddReg(edit code, 1, 10)
    x64LoadSlot(edit code, 2, 14)
    x64CmpReg(edit code, 1, 2)
    x64SetCondition(edit code, 8)
    x64TestRax(edit code)
    hold no_terminator = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 8, 8)
    x64LoadSlot(edit code, 9, 15)
    x64AddReg(edit code, 8, 9)
    x64LoadMem8(edit code, 1, 8, 0)
    x64LoadMem8(edit code, 2, 8, 1)
    x64AddReg(edit code, 1, 2)
    hold unit_zero = wcIf(edit code, 1, 0, 4)
    x64LoadSlot(edit code, 1, 15)
    x64MovImm64(edit code, 10, 2)
    x64AddReg(edit code, 1, 10)
    x64StoreSlot(edit code, 15, 1)
    wcJump(edit code, scan)
    wcPatch(edit code, unit_zero)
    // Strict UTF-16 -> UTF-8; Win32 returns a byte count including NUL.
    x64MovImm64(edit code, 1, 65001)
    x64MovImm64(edit code, 2, 128)
    x64LoadSlot(edit code, 8, 8)
    x64MovImm64(edit code, 9, -1)
    x64MovImm64(edit code, 0, 0)
    each s among 0..4 { wcStack(edit code, s, 0) }
    w64CallImport(edit code, edit imports, pe64ImportWideCharToMultiByte())
    x64TestEax(edit code)
    hold bad_wide = x64ConditionalPlaceholder(edit code, true)
    x64MovImm64(edit code, 10, 1)
    x64SubReg(edit code, 0, 10)
    x64StoreSlot(edit code, 11, 0)
    x64LoadSlot(edit code, 1, 1)
    x64CmpReg(edit code, 0, 1)
    x64SetCondition(edit code, 8)
    x64TestRax(edit code)
    hold too_large = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 7, 11)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 7, 10)
    wcCall(edit code, rt.text_new)
    x64StoreSlot(edit code, 9, 0)
    x64StoreSlot(edit code, 10, 2)
    x64MovImm64(edit code, 1, 65001)
    x64MovImm64(edit code, 2, 128)
    x64LoadSlot(edit code, 8, 8)
    x64MovImm64(edit code, 9, -1)
    x64LoadSlot(edit code, 0, 9)
    wcStack(edit code, 0, 0)
    x64LoadSlot(edit code, 0, 11)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 0, 10)
    wcStack(edit code, 1, 0)
    x64MovImm64(edit code, 0, 0)
    wcStack(edit code, 2, 0)
    wcStack(edit code, 3, 0)
    w64CallImport(edit code, edit imports, pe64ImportWideCharToMultiByte())
    x64LoadSlot(edit code, 1, 11)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 1, 10)
    x64CmpReg(edit code, 0, 1)
    x64SetCondition(edit code, 5)
    x64TestRax(edit code)
    hold bad_copy = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 0, 11)
    x64StoreSlot(edit code, 12, 0)
    hold to_cleanup = x64JumpPlaceholder(edit code)
    wcPatch(edit code, no_text)
    x64MovImm64(edit code, 0, -2)
    x64StoreSlot(edit code, 12, 0)
    wcPatch(edit code, to_cleanup)
    wcPatch(edit code, no_dll)
    wcPatchAll(edit code, view resolve_failed)
    wcPatch(edit code, open_failed)
    wcPatch(edit code, no_data)
    wcPatch(edit code, no_size)
    wcPatch(edit code, no_lock)
    wcPatch(edit code, no_terminator)
    wcPatch(edit code, bad_wide)
    wcPatch(edit code, bad_copy)
    wcPatch(edit code, too_large)
    // Unlock and close before changing the caller's list.
    x64LoadSlot(edit code, 0, 8)
    x64TestRax(edit code)
    hold skip_unlock = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 1, 7)
    w64CallImport(edit code, edit imports, pe64ImportGlobalUnlock())
    wcPatch(edit code, skip_unlock)
    x64LoadSlot(edit code, 0, 13)
    x64TestRax(edit code)
    hold skip_close = x64ConditionalPlaceholder(edit code, true)
    wcFn(edit code, 4)
    x64TestEax(edit code)
    hold close_ok = x64ConditionalPlaceholder(edit code, false)
    x64MovImm64(edit code, 0, -5)
    x64StoreSlot(edit code, 12, 0)
    wcPatch(edit code, close_ok)
    wcPatch(edit code, skip_close)
    x64LoadSlot(edit code, 0, 2)
    x64TestRax(edit code)
    hold skip_release = x64ConditionalPlaceholder(edit code, true)
    x64MovReg(edit code, 1, 0)
    w64CallImport(edit code, edit imports, pe64ImportFreeLibrary())
    wcPatch(edit code, skip_release)
    x64LoadSlot(edit code, 1, 12)
    hold failed = wcIf(edit code, 1, 0, 6)
    x64LoadSlot(edit code, 7, 0)
    x64LoadSlot(edit code, 6, 11)
    x64MovImm64(edit code, 2, 8)
    x64MovImm64(edit code, 1, 8)
    wcCall(edit code, list_reserve)
    x64MovImm64(edit code, 0, 0)
    x64StoreSlot(edit code, 15, 0)
    hold unpack = code.bytes.length
    x64LoadSlot(edit code, 1, 15)
    x64LoadSlot(edit code, 2, 11)
    x64CmpReg(edit code, 1, 2)
    x64SetCondition(edit code, 9)
    x64TestRax(edit code)
    hold unpacked = x64ConditionalPlaceholder(edit code, false)
    x64LoadSlot(edit code, 8, 9)
    x64AddReg(edit code, 8, 1)
    x64LoadMem8(edit code, 2, 8, 0)
    x64LoadSlot(edit code, 8, 0)
    x64LoadMem64(edit code, 8, 8, 0)
    x64MovReg(edit code, 9, 1)
    x64MovImm64(edit code, 10, 8)
    x64MulReg(edit code, 9, 10)
    x64AddReg(edit code, 8, 9)
    x64StoreMem64(edit code, 8, 0, 2)
    x64MovImm64(edit code, 10, 1)
    x64AddReg(edit code, 1, 10)
    x64StoreSlot(edit code, 15, 1)
    wcJump(edit code, unpack)
    wcPatch(edit code, unpacked)
    x64LoadSlot(edit code, 8, 0)
    x64LoadSlot(edit code, 0, 11)
    x64StoreMem64(edit code, 8, 8, 0)
    wcPatch(edit code, failed)
    x64LoadSlot(edit code, 0, 9)
    x64TestRax(edit code)
    hold skip_drop = x64ConditionalPlaceholder(edit code, true)
    x64LoadSlot(edit code, 7, 9)
    x64LoadSlot(edit code, 6, 10)
    wcCall(edit code, rt.text_drop)
    wcPatch(edit code, skip_drop)
    x64LoadSlot(edit code, 0, 12)
    x64FrameEnd(edit code)
    wcPatchAll(edit code, view invalid)
    x64MovImm64(edit code, 0, -1)
    x64FrameEnd(edit code)
    give entry
}

expose flow wcEmitClipboard(code: edit X64Code, imports: edit Pe64Imports, rt: view PfRuntime, list_reserve: Int, utf8: Int) => List of[Int] {
    hold d = wcData(edit code)
    change at: List of[Int] = List[]
    at@push(wcEmitWrite(edit code, edit imports, rt, view d))
    at@push(wcEmitRead(edit code, edit imports, rt, view d, list_reserve))
    give at
}
