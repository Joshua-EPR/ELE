import codegen.native_layout
import codegen.x86_64
import codegen.elf64

// Proof of concept for memory-addressed aggregate layout in a Linux ELF64.
// Stage 0 only bootstraps this ELE source; the output ELF is generated by
// ELE code, with no compiler/linker invocation in this emitter.
// Fields: Int 39, Int 2, Bool 1 => exit(42). Stack-only, no heap/drop yet.
fn main() -> Int {
    var layout = nativeLayoutNew()
    let first = nativeLayoutInt(&mut layout)
    let second = nativeLayoutInt(&mut layout)
    let third = nativeLayoutBool(&mut layout)
    let bytes = nativeLayoutSeal(&mut layout)
    if layout.error != 0 || first != 0 || second != 8 || third != 16 || bytes != 24 { return 2 }

    var code = x64New()
    x64FrameBegin(&mut code, 3) // 24-byte aggregate in 32-byte aligned frame
    x64MovReg(&mut code, 8, 5)  // r8 = rbp
    x64MovImm64(&mut code, 9, 32)
    x64SubReg(&mut code, 8, 9) // r8 = aggregate base, rbp - 32

    x64MovImm64(&mut code, 0, 39)
    x64StoreMem64(&mut code, 8, first, 0)
    x64MovImm64(&mut code, 0, 2)
    x64StoreMem64(&mut code, 8, second, 0)
    x64MovImm64(&mut code, 0, 1)
    x64StoreMem8(&mut code, 8, third, 0)

    x64LoadMem64(&mut code, 7, 8, first)  // rdi = 39
    x64LoadMem64(&mut code, 1, 8, second) // rcx = 2
    x64AddReg(&mut code, 7, 1)
    x64LoadMem8(&mut code, 1, 8, third)   // rcx = 1
    x64AddReg(&mut code, 7, 1)
    x64MovImm64(&mut code, 0, 60) // Linux exit(rdi)
    x64Syscall(&mut code)
    if code.error != 0 { return 3 }

    let binary = elf64Executable(&code.bytes)
    if binary.length == 0 { return 4 }
    if processArgCount() == 1 {
        match processArg(0) {
            Ok(path) => {
                let status = writeBytes(path, binary)
                if status != 0 { return 5 }
                return 0
            }
            Err(code) => { return 6 }
        }
    }
    if processArgCount() != 0 { return 7 }
    let hex = elf64Hex(&binary)
    print("ELE_STACK_ELF_HEX:{hex}")
    return 0
}
