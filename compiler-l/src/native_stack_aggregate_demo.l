take codegen.native_layout
take codegen.x86_64
take codegen.elf64

// Proof of concept for memory-addressed aggregate layout in a Linux ELF64.
// Stage 0 only bootstraps this ELE source; the output ELF is generated by
// ELE code, with no compiler/linker invocation in this emitter.
// Fields: Int 39, Int 2, Bool 1 => exit(42). Stack-only, no heap/drop yet.
flow main() => Int {
    change layout = nativeLayoutNew()
    hold first = nativeLayoutInt(edit layout)
    hold second = nativeLayoutInt(edit layout)
    hold third = nativeLayoutBool(edit layout)
    hold bytes = nativeLayoutSeal(edit layout)
    when layout.error != 0 || first != 0 || second != 8 || third != 16 || bytes != 24 { give 2 }

    change code = x64New()
    x64FrameBegin(edit code, 3) // 24-byte aggregate in 32-byte aligned frame
    x64MovReg(edit code, 8, 5)  // r8 = rbp
    x64MovImm64(edit code, 9, 32)
    x64SubReg(edit code, 8, 9) // r8 = aggregate base, rbp - 32

    x64MovImm64(edit code, 0, 39)
    x64StoreMem64(edit code, 8, first, 0)
    x64MovImm64(edit code, 0, 2)
    x64StoreMem64(edit code, 8, second, 0)
    x64MovImm64(edit code, 0, 1)
    x64StoreMem8(edit code, 8, third, 0)

    x64LoadMem64(edit code, 7, 8, first)  // rdi = 39
    x64LoadMem64(edit code, 1, 8, second) // rcx = 2
    x64AddReg(edit code, 7, 1)
    x64LoadMem8(edit code, 1, 8, third)   // rcx = 1
    x64AddReg(edit code, 7, 1)
    x64MovImm64(edit code, 0, 60) // Linux exit(rdi)
    x64Syscall(edit code)
    when code.error != 0 { give 3 }

    hold binary = elf64Executable(view code.bytes)
    when binary.length == 0 { give 4 }
    when processArgCount() == 1 {
        choose processArg(0) {
            Ok(path) : {
                hold status = writeBytes(path, binary)
                when status != 0 { give 5 }
                give 0
            }
            Err(code) : { give 6 }
        }
    }
    when processArgCount() != 0 { give 7 }
    hold hex = elf64Hex(view binary)
    print("ELE_STACK_ELF_HEX:{hex}")
    give 0
}
