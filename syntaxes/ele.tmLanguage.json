{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ELE",
  "scopeName": "source.ele",
  "fileTypes": ["l"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ele",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ele",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ele",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ele",
              "match": "\\\\(u\\{[0-9a-fA-F]+\\}|[nrt\\\\\"0])"
            },
            {
              "name": "meta.interpolation.ele",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.ele",
          "match": "\\b(flow|shape|choice|fixed|take|expose)\\b"
        },
        {
          "name": "keyword.control.ele",
          "match": "\\b(when|otherwise|during|each|among|give|choose|break|continue)\\b"
        },
        {
          "name": "keyword.ownership.ele",
          "match": "\\b(hold|change|view|edit)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ele",
          "match": "\\b(Int|Bool|Float|Text)\\b"
        },
        {
          "name": "support.type.collection.ele",
          "match": "\\b(List|Option|Result)\\b"
        },
        {
          "name": "entity.name.type.ele",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ele",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.ele" }
          }
        },
        {
          "match": "@([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.method.ele" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ele",
          "match": "=>"
        },
        {
          "name": "keyword.operator.method.ele",
          "match": "@"
        },
        {
          "name": "keyword.operator.comparison.ele",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.ele",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.ele",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.ele",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.optional.ele",
          "match": "(\\?\\?|\\?)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ele",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ele",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
