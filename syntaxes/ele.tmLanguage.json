{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ELE",
  "scopeName": "source.ele",
  "fileTypes": [
    "l"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#method_calls"
    },
    {
      "include": "#generics"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ele",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ele",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ele",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ele",
              "match": "\\\\(u\\{[0-9a-fA-F]+\\}|[nrt\\\\\"0])"
            },
            {
              "name": "meta.interpolation.ele",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.ele"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.ele"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "method_calls": {
      "patterns": [
        {
          "name": "meta.method-call.ele",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.method.ele"
            },
            "2": {
              "name": "entity.name.function.method.ele"
            }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "match": "\\b(of)\\s*(\\[)",
          "captures": {
            "1": {
              "name": "keyword.other.generic.ele"
            },
            "2": {
              "name": "punctuation.bracket.square.ele"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.ele",
          "match": "\\b(flow|shape|choice|extend|contract|fixed|take|space|zone|expose)\\b"
        },
        {
          "name": "keyword.control.ele",
          "match": "\\b(when|otherwise|during|repeat|leave|proceed|each|among|give|choose|break|continue)\\b"
        },
        {
          "name": "keyword.control.async.ele",
          "match": "\\b(later|wait|launch)\\b"
        },
        {
          "name": "storage.modifier.ownership.ele",
          "match": "\\b(hold|change|exclusive|direct|view|edit)\\b"
        },
        {
          "name": "variable.language.this.ele",
          "match": "\\b(this|self)\\b"
        },
        {
          "name": "keyword.other.on.ele",
          "match": "\\b(on)\\b"
        },
        {
          "name": "keyword.declaration.legacy.ele",
          "match": "\\b(fn|struct|impl|enum|trait|pub|let|var|const|import|module|region)\\b"
        },
        {
          "name": "keyword.control.legacy.ele",
          "match": "\\b(return|match|if|else|for|in|while|loop|async|await|spawn)\\b"
        },
        {
          "name": "storage.modifier.legacy.ele",
          "match": "\\b(mut|static)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ele",
          "match": "\\b(Int|Bool|Float|Text|Byte|Char|Unit|Self|Void)\\b"
        },
        {
          "name": "support.type.collection.ele",
          "match": "\\b(List|Option|Result)\\b"
        },
        {
          "name": "entity.name.type.ele",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ele",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.other.identifier.ele",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(?:flow|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.ele"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.ele"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ele",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.legacy.ele",
          "match": "->"
        },
        {
          "name": "keyword.operator.method.ele",
          "match": "@"
        },
        {
          "name": "keyword.operator.comparison.ele",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.ele",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.ele",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.ele",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.optional.ele",
          "match": "(\\?\\?|\\?)"
        },
        {
          "name": "keyword.operator.colon.ele",
          "match": ":"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ele",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.ele",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.ele",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.ele",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "match": "\\b(fixed)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.ele"
            },
            "2": {
              "name": "variable.other.constant.declaration.ele"
            }
          }
        },
        {
          "match": "\\b(hold|change)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.ownership.ele"
            },
            "2": {
              "name": "variable.other.declaration.ele"
            }
          }
        },
        {
          "match": "(?<=[(,])\\s*([a-z_][a-zA-Z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "variable.parameter.ele"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "(\\.)([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ele"
            },
            "2": {
              "name": "variable.other.member.ele"
            }
          }
        },
        {
          "name": "variable.other.readwrite.ele",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
